generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum CompanyStatus {
  active
  suspended
}

enum CompanySource {
  self
  superadmin
}
model Company {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  status    CompanyStatus @default(active)
  source    CompanySource @default(self)
  createdAt DateTime @default(now())
  settings  Json?
  users User[]
  roles Role[]
  categories Category[]
  warehouses Warehouse[]
  products Product[]
  stocks Stock[]
  customers Customer[]
  suppliers Supplier[]
  purchases Purchase[]
  sales Sale[]
  invoices Invoice[]
  expenses Expense[]
  expenseCategories ExpenseCategory[]
  transfers Transfer[]
  purchaseReturns PurchaseReturn[]
  saleReturns SaleReturn[]
  billers Biller[]
  brands Brand[]
  units Unit[]
  adjustments Adjustment[]
  auditLogs AuditLog[]
}

model Role {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  permissions Json?    // ✅ Admin jo checkboxes tick karega wo yahan save honge
  users       User[]
  @@unique([companyId, name])
}

model User {
  id        Int      @id @default(autoincrement())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  isSuperAdmin Boolean @default(false)
  email     String   @unique
  name      String?
  phone     String?
  address   String?
  status    String   @default("active")
  password  String
  roleId    Int?
  role      Role?    @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  lastLoginAt DateTime?
  notifications     Notification[]
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  auditLogs AuditLog[]
  announcements Announcement[] @relation("AnnouncementAuthor")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  Int?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorName  String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model LoginAttempt {
  bucketKey       String   @id @db.Char(64)
  failedAttempts  Int      @default(0)
  maxAttempts     Int
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
  @@index([blockedUntil])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(191)
  body        String   @db.Text
  isActive    Boolean  @default(true)
  startsAt    DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?
  createdBy   User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, expiresAt])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int
  title     String
  message   String   @db.Text
  type      String   // ORDER | LOW_STOCK | PAYMENT | MESSAGE
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Message {
  id               String   @id @default(cuid())
  senderId         Int
  recipientId      Int
  subject          String
  body             String   @db.Text
  isRead           Boolean  @default(false)
  isStarred        Boolean  @default(false)
  isDraft          Boolean  @default(false)
  senderDeleted    Boolean  @default(false)
  recipientDeleted Boolean  @default(false)
  createdAt        DateTime @default(now())
  sender           User     @relation("SentMessages", fields: [senderId], references: [id])
  recipient        User     @relation("ReceivedMessages", fields: [recipientId], references: [id])

  @@index([recipientId, isRead])
}

model Category {
  id       Int        @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  name     String
  image    String?
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
}

model Warehouse {
  id              Int              @id @default(autoincrement())
  companyId       Int
  company         Company @relation(fields: [companyId], references: [id])
  name            String
  phone           String?
  email           String?
  address         String?
  stocks          Stock[]
  Purchases       Purchase[]
  expenses        Expense[]
  purchaseReturns PurchaseReturn[]
  Sales           Sale[]
  adjustments     Adjustment[]
  saleReturns     SaleReturn[]
  transferOut     Transfer[]       @relation("FromWarehouse")
  transferIn      Transfer[]       @relation("ToWarehouse")
  billers         Biller[]
}

model Product {
  id                  Int                  @id @default(autoincrement())
  companyId           Int
  company             Company              @relation(fields: [companyId], references: [id])
  name                String
  sku                 String
  price               Decimal              @db.Decimal(10, 2)
  costPrice           Decimal              @db.Decimal(10, 2)
    promotionalPrice    Decimal?             @db.Decimal(10, 2)
  batchNo             String?
  categoryId          Int
  category            Category             @relation(fields: [categoryId], references: [id])
  brandId             Int?
  brand               Brand?               @relation(fields: [brandId], references: [id])
  unitId              Int?
  unit                Unit?                @relation(fields: [unitId], references: [id])
  stocks              Stock[]
  PurchaseItem        PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  SaleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  TransferItem        TransferItem[]
  adjustmentItems     AdjustmentItem[]
  createdAt           DateTime             @default(now())
  @@unique([companyId, sku])
}

model Stock {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  productId   Int
  warehouseId Int
  quantity    Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@index([productId])
}

model Customer {
  id            Int     @id @default(autoincrement())
  companyId     Int
  company       Company @relation(fields: [companyId], references: [id])
  name          String
  customerGroup String  @default("General")
  phone         String?
  email         String?
  country       String?
  city          String?
  address       String?
  zipCode       String?
  rewardPoints  Int     @default(0)
  sales         Sale[]
}

model Supplier {
  id           Int        @id @default(autoincrement())
  companyId    Int
  companyTenant Company   @relation(fields: [companyId], references: [id])
  name         String
  phone        String?
  email        String?
  country      String?
  city         String?
  address      String?
  zipCode      String?
  company      String?
  supplierCode String?
  purchases    Purchase[]
  @@unique([companyId, supplierCode])
}

model Purchase {
  id             Int               @id @default(autoincrement())
  companyId      Int
  company        Company           @relation(fields: [companyId], references: [id])
  reference      String?
  supplierId     Int
  warehouseId    Int
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  items          PurchaseItem[]
  payments       PurchasePayment[]
  returns        PurchaseReturn[]
  shippingCharge Decimal           @default(0) @db.Decimal(10, 2)
  note           String?
  status         PurchaseStatus    @default(pending)
  totalAmount    Decimal           @db.Decimal(10, 2)
  createdAt      DateTime          @default(now())
  @@unique([companyId, reference])
}

model PurchasePayment {
  id            Int               @id @default(autoincrement())
  purchaseId    Int
  purchase      Purchase          @relation(fields: [purchaseId], references: [id])
  amountPaid    Decimal           @db.Decimal(10, 2)
  paymentMethod PaymentMethodType
  paidAt        DateTime          @default(now())
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

enum PaymentMethodType {
  cash
  card
  upi
  bank_transfer
  credit
}

enum PurchaseStatus {
  pending
  completed
  cancelled
}

model Sale {
  id             Int               @id @default(autoincrement())
  companyId      Int
  company        Company           @relation(fields: [companyId], references: [id])
  reference      String?
  customerId     Int
  warehouseId    Int
  billerId       Int?
  customer       Customer          @relation(fields: [customerId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  biller         Biller?           @relation(fields: [billerId], references: [id])
  items          SaleItem[]
  paymentMethod  PaymentMethodType @default(cash)
  shippingCharge Decimal           @default(0) @db.Decimal(10, 2)
  status         SaleStatus        @default(pending)
  note           String?
  staffRemark    String?
  invoice        Invoice?
  returns        SaleReturn[]
  createdAt      DateTime          @default(now())
  @@unique([companyId, reference])
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  batchNo   String?
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  tax       Decimal @default(0) @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

model Invoice {
  id            Int           @id @default(autoincrement())
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id])
  invoiceNumber String
  saleId        Int           @unique
  sale          Sale          @relation(fields: [saleId], references: [id])
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @db.Decimal(10, 2)
  taxPercent    Decimal       @default(0) @db.Decimal(5, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(unpaid)
  payments      Payment[]
  issuedAt      DateTime      @default(now())
  @@unique([companyId, invoiceNumber])
}

model Payment {
  id            Int               @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice           @relation(fields: [invoiceId], references: [id])
  amountPaid    Decimal           @db.Decimal(10, 2)
  paymentMethod PaymentMethodType
  referenceNo   String?
  paidAt        DateTime          @default(now())
}

model ExpenseCategory {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  subCategory String?   
  expenses    Expense[]
}

enum ExpenseType {
  direct
  indirect
}

model Expense {
  id          Int              @id @default(autoincrement())
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id])
  reference   String?
  voucherNo   String?
  categoryId  Int
  category    ExpenseCategory  @relation(fields: [categoryId], references: [id])
  warehouseId Int?
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])
  expenseType ExpenseType      @default(direct)
  amount      Decimal          @db.Decimal(10, 2)
  description String?
  date        DateTime         @default(now())
  payments    ExpensePayment[]
  @@unique([companyId, reference])
}

enum PaymentRecordStatus {
  pending
  completed
}

model ExpensePayment {
  id            Int                 @id @default(autoincrement())
  expenseId     Int
  expense       Expense             @relation(fields: [expenseId], references: [id])
  status        PaymentRecordStatus @default(completed)
  amountPaid    Decimal             @db.Decimal(10, 2)
  paymentMethod PaymentMethodType
  cardLast4     String?
  note          String?
  paidAt        DateTime            @default(now())
}

enum TransferStatus {
  pending
  completed
  rejected
}

model Transfer {
  id              Int            @id @default(autoincrement())
  companyId       Int
  company         Company        @relation(fields: [companyId], references: [id])
  reference       String?
  date            DateTime       @default(now())
  fromWarehouseId Int
  toWarehouseId   Int
  fromWarehouse   Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  items           TransferItem[]
  reason          String?
  authorizedBy    String?
  status          TransferStatus @default(completed)
  note            String?
  createdAt       DateTime       @default(now())
  @@unique([companyId, reference])
}

model TransferItem {
  id         Int      @id @default(autoincrement())
  transferId Int
  productId  Int
  quantity   Int
  transfer   Transfer @relation(fields: [transferId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model PurchaseReturn {
  id          Int                  @id @default(autoincrement())
  companyId   Int
  company     Company              @relation(fields: [companyId], references: [id])
  reference   String?
  purchaseId  Int
  warehouseId Int
  purchase    Purchase             @relation(fields: [purchaseId], references: [id])
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  items       PurchaseReturnItem[]
  totalAmount Decimal              @db.Decimal(10, 2)
  reason      String?
  createdAt   DateTime             @default(now())
  @@unique([companyId, reference])
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  productId        Int
  quantity         Int
  price            Decimal        @db.Decimal(10, 2)
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
}

model Biller {
  id          Int        @id @default(autoincrement())
  companyId   Int
  company     Company    @relation(fields: [companyId], references: [id])
  name        String
  phone       String?
  email       String?
  address     String?
  dateOfJoin  DateTime?  @default(now())
  nidPassport String?
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  zipCode     String?
  billerCode  String?
  sales       Sale[]
  @@unique([companyId, billerCode])
}

enum SaleStatus {
  pending
  completed
  cancelled
}

model SaleReturn {
  id          Int              @id @default(autoincrement())
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id])
  reference   String?
  saleId      Int
  warehouseId Int
  sale        Sale             @relation(fields: [saleId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  items       SaleReturnItem[]
  totalAmount Decimal          @db.Decimal(10, 2)
  reason      String?
  createdAt   DateTime         @default(now())
  @@unique([companyId, reference])
}

model SaleReturnItem {
  id           Int        @id @default(autoincrement())
  saleReturnId Int
  productId    Int
  quantity     Int
  price        Decimal    @db.Decimal(10, 2)
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
}

model Brand {
  id       Int       @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  name     String
  image    String?   @db.LongText
  products Product[]
}

model Unit {
  id        Int       @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  name      String
  shortName String
  products  Product[]
}

enum AdjustmentType {
  addition
  subtraction
}

model Adjustment {
  id          Int              @id @default(autoincrement())
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id])
  reference   String?
  warehouseId Int
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  remarks     String?
  items       AdjustmentItem[]
  createdAt   DateTime         @default(now())
  @@unique([companyId, reference])
}

model AdjustmentItem {
  id           Int            @id @default(autoincrement())
  adjustmentId Int
  productId    Int
  batchNo      String?
  quantity     Int
  type         AdjustmentType
  adjustment   Adjustment     @relation(fields: [adjustmentId], references: [id])
  product      Product        @relation(fields: [productId], references: [id])
}
